{
  // 仅校验文档源文件，排除构建产物与依赖
  "globs": ["docs/**/*.md"],
  "ignores": ["node_modules", "docs/.vitepress/cache", "docs/.vitepress/dist"],
  "config": {
    "default": true,

    // MD013 行长度：技术文档常含长链接/代码，不限制
    "MD013": false,

    // MD033 允许内联 HTML：VitePress 主题/容器需要
    "MD033": false,

    // MD060 表格管道空格属纯样式，且与现有书写风格冲突，交给后续统一格式化处理
    "MD060": false,

    // MD040 代码块语言：大量历史文档未标注，先不阻断 CI，作为渐进治理项
    "MD040": false,

    // 以下表格/强调样式规则对 markdown-it 解析较敏感（如单元格内 `||`、紧贴 ::: 容器），
    // 现有文档存在大量误报，先收敛为非阻断，后续作内容治理时再逐项开启
    "MD036": false,
    "MD055": false,
    "MD056": false,

    // MD041 首行不强制为一级标题：很多文档以 frontmatter 或容器开头
    "MD041": false,

    // MD024 允许不同层级下的重复标题（如多个“示例”小节）
    "MD024": { "siblings_only": true },

    // MD025 允许 frontmatter title 与正文 H1 共存
    "MD025": { "front_matter_title": "" },

    // 列表缩进按 2 空格
    "MD007": { "indent": 2 },

    // 有序列表统一从 1 递增
    "MD029": { "style": "ordered" },

    // 允许裸 URL（导航页/参考链接较多）
    "MD034": false,
  },
}
