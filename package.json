{
  "name": "gengzzzdoc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:doc": "node scripts/check-doc.mjs",
    "check": "npm run lint:md && npm run format:check && npm run docs:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.4",
    "vitepress": "^1.6.3",
    "vue": "^3.5.39"
  },
  "lint-staged": {
    "docs/**/*.md": "markdownlint-cli2 --fix",
    "*.{ts,vue,css,json,yml,yaml,js}": "prettier --write"
  },
  "overrides": {
    "vite": "6.4.2",
    "esbuild": "0.25.0"
  }
}
